{
  "name": "AStarBot (Python 3.12)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "interfaces/streamlit_app.py"]
    },
    "vscode": {
      "settings": {},
      "extensions": ["ms-python.python", "ms-python.vscode-pylance", "charliermarsh.ruff"]
    }
  },
  "updateContentCommand": "pip3 install --user --extra-index-url https://download.pytorch.org/whl/cpu -e '.[dev]' && echo '✅ Packages installed'",
  "postAttachCommand": {
    "server": "streamlit run interfaces/streamlit_app.py --server.enableCORS false --server.enableXsrfProtection false"
  },
  "portsAttributes": {
    "8501": { "label": "Streamlit", "onAutoForward": "openPreview" },
    "8000": { "label": "API" }
  },
  "forwardPorts": [8501, 8000]
}
