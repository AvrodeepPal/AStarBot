# ============================================================
# AStarBot v2.4.0 — environment template
# Copy to .env and fill in secrets. Never commit .env.
# Every variable here is declared in rag/config.py; anything
# omitted falls back to the default shown.
# ============================================================

# ---- Pinecone (index must be 768-d, cosine) ----
PINECONE_API_KEY=pcsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PINECONE_INDEX_NAME=astarbot
PINECONE_NAMESPACE=astarbot

# ---- Embedding ----
# Where the QUERY encoder runs. Same model + dimension either way, so the
# Pinecone index is unaffected by switching.
#   hf    Hugging Face Inference API. Needs HF_TOKEN. No torch in RAM
#         (~150 MB total) — use this on Railway's free tier.
#   local sentence-transformers in-process. Needs the [local-embed] extra
#         (`make install-local`) and ~1 GB RAM.
#   auto  hf when HF_TOKEN is set, otherwise local.
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768
EMBEDDING_DEVICE=cpu
QUERY_PREFIX="Represent this sentence for searching relevant passages: "

# Hugging Face token (read access is enough): https://huggingface.co/settings/tokens
# Left empty here on purpose: with EMBEDDING_BACKEND=auto, any non-empty
# value (even a placeholder) switches the API to the HF backend.
# Free accounts get a small monthly inference credit and are rate-limited;
# 503 (model loading) and 429 (rate limit) are retried with backoff.
HF_TOKEN=
HF_TIMEOUT_SECONDS=15
HF_MAX_RETRIES=3
# Leave unset to derive it from EMBEDDING_MODEL:
# https://router.huggingface.co/hf-inference/models/<model>/pipeline/feature-extraction
# HF_EMBEDDING_URL=

# ---- Retrieval ----
# Over-fetch FETCH_K candidates, then re-rank by cosine + PRIORITY_WEIGHT *
# priority and keep TOP_K. PRIORITY_WEIGHT=0 ranks by cosine alone.
TOP_K=5
FETCH_K=10
PRIORITY_WEIGHT=0.02
# 0.0 = off. `make calibrate` shows on-/off-topic scores overlap on this
# knowledge base, so the prompt's SCOPE block does the refusing, not a number.
MIN_RETRIEVAL_SCORE=0.0
# Maximal marginal relevance over the FETCH_K candidates. 1.0 = off (default
# since v2.4.0: no duplicate crowding measured, and MMR needs the raw vectors
# back from Pinecone on every query). 0.7 turns it back on.
MMR_LAMBDA=1.0
# In-process LRU of finished retrievals (case/whitespace-insensitive key).
# 64 entries is well under 1 MB. 0 disables it.
RETRIEVAL_CACHE_SIZE=64

# ---- Groq LLM tiers ----
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
PRIMARY_LLM_MODEL=openai/gpt-oss-20b
FALLBACK_LLM_MODEL=openai/gpt-oss-120b
SUMMARIZER_LLM_MODEL=openai/gpt-oss-20b
TEMPERATURE=0.4
SUMMARIZER_TEMPERATURE=0.0
MAX_ANSWER_TOKENS=400
# gpt-oss accepts low | medium | high and CANNOT turn reasoning off.
# An EMPTY value does not disable it: it omits the parameter, and Groq then
# uses the model default (medium) — slower than low. Keep this at "low".
# Reasoning tokens come out of the MAX_ANSWER_TOKENS budget.
REASONING_EFFORT=low
GUARD_THRESHOLD=0.5
LLM_TIMEOUT_SECONDS=30

# ---- Memory (stateless, client-managed) ----
ENABLE_SUMMARY=true
SUMMARY_TRIGGER_AFTER=10
# Last N MESSAGES ride in the user prompt as a labelled RECENT EXCHANGE block
# so "how did he do it" has a referent before the summary kicks in.
# 2 = the previous question + its answer. 0 = off.
RECENT_TURNS_IN_PROMPT=2
SUMMARY_MAX_LINES=5
MAX_RECENT_MESSAGES=12
MESSAGES_AFTER_SUMMARY=4

# ---- Guardrails ----
MAX_QUESTION_CHARS=500
MAX_MESSAGE_CHARS=2000
MAX_SUMMARY_CHARS=2000
MAX_MESSAGES_SENT=20
MAX_ANSWER_CHARS=2000
ENABLE_PROMPT_GUARD_LLM=true

# ---- API ----
# POST /chat/stream (token streaming). /chat is always on. With this off the
# Streamlit app falls back to /chat automatically.
ENABLE_STREAMING_ENDPOINT=true
# Recycle the single uvicorn worker after this many requests (main.py keeps
# a supervisor that respawns it; queued requests wait ~2-3 s, none dropped).
# 0 = never recycle.
WORKER_MAX_REQUESTS=500

# ---- CORS (comma-separated origins, or *) ----
FRONTEND_ORIGIN=http://localhost:3000,https://avrodeeppal-portfolio.vercel.app

# ---- Streamlit client (interfaces/streamlit_app.py only; not read by
# rag.config.Settings) ----
# Points the Streamlit thin client at the deployed API instead of a local
# RAGEngine, so Streamlit Cloud's 1 GB RAM cap is never at risk. On Streamlit
# Community Cloud this goes in *Secrets* using the same KEY = "value" TOML
# syntax; falls back to http://localhost:8000 for local dev. HF_TOKEN is NOT
# needed there — only the API embeds.
ASTARBOT_API_URL=https://<your-railway-domain>

# ---- Runtime ----
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
DEBUG=false
